-- Input contract: invoke through Main, not directly on unvalidated BPMN.
-- BpsimInput (when selected) resolves scenario parameters into compatibility
-- attributes in seconds. BpmnPreflight then validates topology and normalizes
-- legacy generator defaults, timer starts and gateway Choice expressions.
-- InterArrivalTime and EntitiesPerArrival must be positive on entry.
-- This module maps process structure only: Main supplies Simulation settings
-- (duration, warmup, replication seeds); M2T supplies CFG names and layout.
-- Task entry is its Queue; the Server pulls through waitQueue. An XOR merge
-- forwards each arriving entity independently; it does not synchronize tokens.
module Rules;
create OUT : Jaamsim from IN : BPMN;

helper def: get(o : OclAny, featureName : String) : OclAny =
  if o.oclIsUndefined() then OclUndefined else
    let f : OclAny = o.eClass().getEStructuralFeature(featureName) in
      if f.oclIsUndefined() then OclUndefined else o.eGet(f) endif
  endif;
helper def: safeStr(v : OclAny, fallback : String) : String =
  if v.oclIsUndefined() then fallback else
    if v.toString().trim() = '' then fallback else v.toString() endif
  endif;
helper def: safeId(x : OclAny) : String =
  thisModule.safeStr(thisModule.get(x, 'id'), x.eResource().getURIFragment(x));
helper def: owningDefinitions(x : OclAny) : OclAny =
  if x.oclIsUndefined() then OclUndefined else
    if x.oclIsKindOf(BPMN!Definitions) then x
    else thisModule.owningDefinitions(x.eContainer()) endif
  endif;
helper context BPMN!Definitions def: processes() : Sequence(OclAny) =
  self.rootElements->select(e | e.oclIsKindOf(BPMN!Process))->asSequence();
helper def: flowNodes(p : OclAny) : Sequence(OclAny) =
  p.flowElements->select(e | e.oclIsKindOf(BPMN!FlowNode))->asSequence();
helper def: seqFlows(p : OclAny) : Sequence(OclAny) =
  p.flowElements->select(e | e.oclIsKindOf(BPMN!SequenceFlow))->asSequence();
-- Choice indices follow the persisted outgoing reference order.
helper def: outFlows(fn : OclAny) : Sequence(OclAny) = fn.outgoing->asSequence();
helper def: entryComponent(fn : OclAny) : Jaamsim!ProcessComponent =
  if fn.oclIsUndefined() then OclUndefined else
    if fn.oclIsKindOf(BPMN!StartEvent) then thisModule.resolveTemp(fn, 'gen') else
    if fn.oclIsKindOf(BPMN!Task) then thisModule.resolveTemp(fn, 'q') else
    if fn.oclIsKindOf(BPMN!EndEvent) then thisModule.resolveTemp(fn, 'sink') else
    if fn.oclIsKindOf(BPMN!ExclusiveGateway) then thisModule.resolveTemp(fn, 'br')
    else OclUndefined endif endif endif endif
  endif;
helper def: nextConveyor(fn : OclAny) : Jaamsim!EntityConveyor =
  if thisModule.outFlows(fn)->isEmpty() then OclUndefined
  else thisModule.resolveTemp(thisModule.outFlows(fn)->first(), 'conv') endif;

rule Definitions2SimulationModel {
  from d : BPMN!Definitions
  to sm : Jaamsim!SimulationModel (
    name <- thisModule.safeStr(d.name, 'SimModel'),
    entities <- Sequence{se},
    components <- d.processes()->collect(p |
      thisModule.flowNodes(p)->collect(n | thisModule.entryComponent(n)))->flatten()
      ->union(d.processes()->collect(p | thisModule.flowNodes(p)
        ->select(n | n.oclIsKindOf(BPMN!Task))
        ->collect(t | thisModule.resolveTemp(t, 'srv')))->flatten())
      ->union(d.processes()->collect(p | thisModule.seqFlows(p)
        ->collect(sf | thisModule.resolveTemp(sf, 'conv')))->flatten())->asSequence()
  ),
  se : Jaamsim!SimEntity (name <- 'Entity1')
}
rule SequenceFlow2EntityConveyor {
  from sf : BPMN!SequenceFlow
  to conv : Jaamsim!EntityConveyor (
    name <- 'Conveyor_' + thisModule.safeId(sf),
    nextComponent <- thisModule.entryComponent(sf.targetRef),
    travelTime <- sf.TravelTime
  )
}
rule StartEvent2EntityGenerator {
  from s : BPMN!StartEvent
  to gen : Jaamsim!EntityGenerator (
    name <- thisModule.safeStr(s.name, 'Start_' + thisModule.safeId(s)),
    prototype <- thisModule.resolveTemp(thisModule.owningDefinitions(s), 'se'),
    firstArrivalTime <- s.FirstArrivalTime,
    interArrivalTime <- s.InterArrivalTime,
    entitiesPerArrival <- s.EntitiesPerArrival,
    maxNumber <- s.MaxNumber,
    nextComponent <- thisModule.nextConveyor(s)
  )
}
rule Task2Server {
  from t : BPMN!Task
  to q : Jaamsim!Queue (name <- 'Queue_' + thisModule.safeId(t), fifo <- true),
  srv : Jaamsim!Server (
    name <- thisModule.safeStr(t.name, 'Task_' + thisModule.safeId(t)),
    serviceTime <- t.Time,
    nextComponent <- thisModule.nextConveyor(t),
    waitQueue <- q
  )
}
rule EndEvent2EntitySink {
  from e : BPMN!EndEvent
  to sink : Jaamsim!EntitySink (
    name <- thisModule.safeStr(e.name, 'End_' + thisModule.safeId(e))
  )
}
rule ExclusiveGateway2Branch {
  from gw : BPMN!ExclusiveGateway
  to br : Jaamsim!Branch (
    name <- thisModule.safeStr(gw.name, 'XOR_' + thisModule.safeId(gw)),
    nextComponentList <- thisModule.outFlows(gw)
      ->collect(sf | thisModule.resolveTemp(sf, 'conv'))->asSequence(),
    choice <- gw.Choice
  )
}
