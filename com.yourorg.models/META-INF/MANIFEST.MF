Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: Models;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;bundle-version="2.41.0";visibility:=reexport,
 org.eclipse.emf.common;bundle-version="2.44.0",
 org.eclipse.emf.ecore.xmi;bundle-version="2.39.0"
Bundle-ActivationPolicy: lazy
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Automatic-Module-Name: Models
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: jaamsim,
 jaamsim.impl,
 jaamsim.util
